# Copy to .env and add credentials. Never commit .env.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
ASANA_ACCESS_TOKEN=
LINEAR_API_KEY=

# ChatGPT powers /api/query. Without a key the API stays in local mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com.
OPENAI_BASE_URL=
OPENAI_TIMEOUT=30
