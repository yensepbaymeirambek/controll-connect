# Copy to .env and add credentials. Never commit .env.

# --- Jira, reached through an MCP server ---
# Used by the bundled mcp-atlassian service (docker compose --profile jira up).
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Where the backend looks for the Jira MCP server. Leave empty and the
# workspace reports that nothing is connected.
#   --profile jira          -> http://jira-mcp:9000/mcp
#   docker-compose.demo.yml -> http://fake-jira-mcp:9100/mcp (no credentials needed)
JIRA_MCP_URL=
JIRA_MCP_TOOL=jira_search
JIRA_MCP_TOKEN=
JIRA_JQL=ORDER BY updated DESC
JIRA_LIMIT=100

# --- ChatGPT: powers chat and dashboard-card generation ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com.
OPENAI_BASE_URL=

# Seconds a fetched record set is reused before refetching from MCP.
RECORDS_CACHE_TTL=60
